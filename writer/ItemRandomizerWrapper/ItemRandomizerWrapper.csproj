<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- RandomizerCommon's allocation-heavy game-data work is GC-bound
         under the default workstation GC; server GC scales with cores. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ItemRandomizerWrapper.Core/ItemRandomizerWrapper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RandomizerCommon">
      <HintPath>../lib/RandomizerCommon.dll</HintPath>
    </Reference>
    <!-- Item Randomizer's own SoulsFormats + SoulsIds builds, kept apart from
         FogRando's copies in ../lib/. The two mods' builds have diverged and
         are not interchangeable: SoulsIds.Instr.Callee is int (FogRando) vs uint
         (Item Randomizer), only the Item Randomizer's has Events.RelocMap
         (needed by v0.12+ RandomizerCommon), and the two SoulsFormats.dll builds
         differ byte-for-byte. FogModWrapper links ../lib/{SoulsFormats,SoulsIds}.dll
         instead. (Still the SoulsFormats lineage, not SoulsFormatsNEXT, because
         SoulsIds depends on SFUtil.DecryptNRRegulation, removed in NEXT.) -->
    <Reference Include="SoulsFormats">
      <HintPath>../lib/itemrando/SoulsFormats.dll</HintPath>
    </Reference>
    <Reference Include="SoulsIds">
      <HintPath>../lib/itemrando/SoulsIds.dll</HintPath>
    </Reference>
    <Reference Include="YamlDotNet">
      <HintPath>../lib/YamlDotNet.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>../lib/Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="BouncyCastle.Cryptography">
      <HintPath>../lib/BouncyCastle.Cryptography.dll</HintPath>
    </Reference>
    <Reference Include="ZstdNet">
      <HintPath>../lib/ZstdNet.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Copy native compression libraries and dependencies to output -->
  <ItemGroup>
    <None Include="../lib/oo2core_6_win64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../lib/libzstd.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../lib/Pidgin.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- DI container loaded at runtime by RandomizerCommon (added in v0.12);
         not a compile-time reference, just needs to sit next to the exe -->
    <None Include="../lib/LightInject.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../lib/LightInject.Annotation.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
